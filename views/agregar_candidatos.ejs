<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Agregar Candidato</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  
</head>
<body class="bg-light">
<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-body">
      <h2 class="mb-4">Agregar Candidato a <%= eleccion.nombre %></h2>

      <% if (alert) { %>
        <div class="alert <%= alertClass %> alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
      <% } %>
      

      <form method="POST" action="/elecciones/<%= eleccion.id %>/candidatos">
        <input type="hidden" name="eleccionId" value="<%= eleccion.id %>">

        <div class="mb-3">
          <label class="form-label">Seleccionar Usuario</label>
          <select name="userId" class="form-select" required>
            <% candidatos.forEach(user => { %>
              <% const perfil = user.UserProfile; %>
              <option value="<%= user.id %>">
                <%= user.username %> - 
                <% if (perfil) { %>
                  <%= perfil.name %> <%= perfil.lastName %> (<%= user.identificacion %>)
                <% } else { %>
                  Sin perfil
                <% } %>
              </option>
            <% }) %>
          </select>
          
          
        </div>

        <div class="mb-3">
          <label class="form-label">Propuesta</label>
          <textarea name="propuesta" class="form-control" rows="4" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Agregar Candidato</button>
        <a href="/elecciones" class="btn btn-secondary ms-2">Cancelar</a>
      </form>

      <% if (registros.length > 0) { %>
        <hr class="my-4">
        <h4 class="mb-3">Candidatos Registrados</h4>
        <table class="table table-bordered table-hover">
          <thead class="table-dark">
            <tr>
              <th>#</th>
              <th>Usuario</th>
              <th>Nombre Completo</th>
              <th>Identificación</th>
              <th>Propuesta</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% registros.forEach((registro, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
          
                <!-- Columna de nombre de usuario -->
                <td><%= registro.User?.username %></td>
          
                <!-- Columna de nombres y apellidos si existen -->
                <td class="d-flex align-items-center gap-2">
                  <% if (registro.User && registro.User.UserProfile) { %>
                    <% const foto = registro.User.UserProfile.profile_picture || 'default.jpg'; %>
                    
                    <a href="#" data-bs-toggle="modal" data-bs-target="#modalFoto<%= registro.id %>">
                      <img src="/uploads/<%= foto %>" alt="Foto" width="40" height="40" class="rounded-circle border" style="object-fit: cover;">
                    </a>
                
                    <span><%= registro.User.UserProfile.name %> <%= registro.User.UserProfile.lastName %></span>
                
                    <!-- Modal para mostrar imagen ampliada -->
                    <div class="modal fade" id="modalFoto<%= registro.id %>" tabindex="-1" aria-labelledby="modalLabel<%= registro.id %>" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                          <div class="modal-header">
                            <h5 class="modal-title" id="modalLabel<%= registro.id %>">Foto de <%= registro.User.UserProfile.name %> <%= registro.User.UserProfile.lastName %></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                          </div>
                          <div class="modal-body text-center">
                            <img src="/uploads/<%= foto %>" alt="Foto grande" class="img-fluid rounded">
                          </div>
                        </div>
                      </div>
                    </div>
                  <% } else { %>
                    <em>No registrado</em>
                  <% } %>
                </td>
                
          
                <td><%= registro.User?.identificacion %></td>
                <td><%= registro.propuesta %></td>
                <td class="d-flex gap-1">
                  <a href="/candidaturas/editar/<%= registro.id %>" class="btn btn-sm btn-outline-secondary">Editar</a>
                  <form action="/candidaturas/eliminar/<%= registro.id %>" method="POST" onsubmit="return confirm('¿Eliminar candidatura?');">
                    <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
              
        </table>
      <% } else { %>
        <p class="text-muted mt-4">No hay candidatos registrados aún.</p>
      <% } %>
      

    </div>
  </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    setTimeout(() => {
      const alert = document.querySelector('.alert');
      if (alert) {
        alert.classList.remove('show');
        alert.classList.add('fade');
        setTimeout(() => alert.remove(), 500);
      }
    }, 2000);
  </script>
  
</body>
</html>
