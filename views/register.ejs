<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Registro</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-light">

<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-body">
      <h2 class="card-title text-center mb-4">Registro</h2>

      <% if (alert) { %>
        <div id="alerta" class="alert alert-warning alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
      <% } %>

      <form id="registerForm" action="/register" method="POST" novalidate>
        <div class="mb-3">
          <label class="form-label">Identificación</label>
          <input type="text" class="form-control" name="identificacion" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Correo Electronico</label>
          <input type="email" class="form-control" name="correo" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Usuario</label>
          <input type="text" class="form-control" name="username" required>
        </div>

        <div class="mb-3">

          <label class="form-label">Edad</label>
          <input type="number" class="form-control" name="edad" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Contraseña</label>
          <input type="password" class="form-control" name="password" required minlength="4">
        </div>
        <div class="mb-3">
          <label class="form-label">Rol</label>
          <select class="form-select" name="role" required>
            <option selected disabled value="">Selecciona un rol</option>
            <option value="administrativo">Administrativo</option>
            <option value="candidato">Candidato</option>
            <option value="votante">Votante</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary w-100">Registrar</button>
      </form>


<form action="/admin/users/upload-csv" method="POST" enctype="multipart/form-data" class="mt-4">
  <div class="mb-3">
    <label class="form-label">Cargar archivo CSV</label>
    <input type="file" name="csvfile" accept=".csv" class="form-control" required>
  </div>
  <button type="submit" class="btn btn-success">Importar Usuarios</button>
</form>


      <div class="d-flex justify-content-center mt-3">
        <a href="/dashboard" class="btn btn-outline-secondary">← Volver al Panel de Usuario</a>

      </div>
      
    </div>
  </div>
</div>

 
<script>
  const registerForm = document.getElementById('registerForm');
  const usernameInput = registerForm.querySelector('input[name="username"]');

  // Convierte a minúsculas en tiempo real
  usernameInput.addEventListener('input', function () {
    this.value = this.value.toLowerCase();
  });

  registerForm.addEventListener('submit', function (event) {
    const username = usernameInput.value;

    // Verifica espacios
    if (/\s/.test(username)) {
      event.preventDefault();
      alert('⚠️ El nombre de usuario no debe contener espacios.');
      return;
    }

    // Validación HTML5
    if (!this.checkValidity()) {
      event.preventDefault();
      event.stopPropagation();
    }

    this.classList.add('was-validated');
  });
</script>


<!-- Script para que funcionen las alertas -->
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Auto cerrar alerta -->
<script>
  setTimeout(() => {
    const alerta = document.getElementById('alerta');
    if (alerta) {
      alerta.classList.add('fade-out'); // aplica transición visual
      setTimeout(() => {
        const alertaBootstrap = bootstrap.Alert.getOrCreateInstance(alerta);
        alertaBootstrap.close(); // cierra la alerta después de la animación
      }, 500); // espera a que termine la transición CSS (0.5s)
    }
  }, 5000);
</script>

</body>
</html>
