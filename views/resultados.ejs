<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Resultados de Elecciones</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-light">

  
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">Panel de Control - Sistema de Votación FIS - USTA</a>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav ms-auto">
                        <li class="icono-inicio">
                <a href="/" title="Inicio">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-house-door" viewBox="0 0 16 16">
                    <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4z"/>
                  </svg>
                  <span>Inicio</span>
                </a>
              </li>
             <li class="icono-nameUser">
              <a href="/miPerfil" class="nav-link text-warning d-flex align-items-center">
                <svg class="icon-user" xmlns="http://www.w3.org/2000/svg"  viewBox="0 0 16 16" width="30" height="30" fill="currentColor">
                  <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                </svg>
                <span class="ms-1">Bienvenido, <strong><%= user.username %></strong></span>
              </a>
            </li>
            <li class="icono-cerrar-sesion">
              <a class="nav-link text-white"
                href="/logout">Cerrar Sesión</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

  
<div class="container mt-5">
  <h2 class="mb-4">Resultados de Elecciones</h2>

  <% elecciones.forEach(eleccion => { %>
    <div class="card mb-4">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span><strong><%= eleccion.nombre %></strong> - <%= eleccion.estado %></span>
        <a href="/resultados/<%= eleccion.id %>" class="btn btn-light btn-sm">Ver Detalles →</a>
      </div>
      <div class="card-body">
        <% if (eleccion.Candidaturas.length === 0) { %>
          <p class="text-muted">No hay candidatos registrados.</p>
        <% } else { 
          const maxVotos = Math.max(...eleccion.Candidaturas.map(c => c.Votos.length));
        %>
          <table class="table table-bordered">
            <thead class="table-light">
              <tr>
                <th>Candidato</th>
                <th>Propuesta</th>
                <th>Votos</th>
              </tr>
            </thead>
            <tbody>
              <% eleccion.Candidaturas.forEach(c => { %>
                <tr class="<%= c.Votos.length === maxVotos && maxVotos > 0 ? 'table-success' : '' %>">
                  <td>
                    <%= c.User?.UserProfile?.name || '' %> <%= c.User?.UserProfile?.lastName || '' %>
                    (<%= c.User?.username %>)
                  </td>

                  <td><%= c.propuesta %></td>

                  <td><strong><%= c.Votos.length %></strong></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <p class="text-muted">* El candidato resaltado en verde es quien obtuvo más votos.</p>
        <% } %>
      </div>
    </div>
  <% }) %>

  <a href="/dashboard" class="btn btn-outline-secondary mt-3">← Volver al Dashboard</a>
</div>
</body>
</html>
