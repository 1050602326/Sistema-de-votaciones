<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Mi Perfil</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-light">

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">Panel de Control - Sistema de Votación FIS - USTA</a>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav ms-auto">
                        <li class="icono-inicio">
                <a href="/" title="Inicio">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-house-door" viewBox="0 0 16 16">
                    <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4z"/>
                  </svg>
                  <span>Inicio</span>
                </a>
              </li>
             <li class="icono-nameUser">
              <a href="/miPerfil" class="nav-link text-warning d-flex align-items-center">
                <svg class="icon-user" xmlns="http://www.w3.org/2000/svg"  viewBox="0 0 16 16" width="30" height="30" fill="currentColor">
                  <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                </svg>
                <span class="ms-1">Bienvenido, <strong><%= user.username %></strong></span>
              </a>
            </li>
            <li class="icono-cerrar-sesion">
              <a class="nav-link text-white"
                href="/logout">Cerrar Sesión</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

<div class="container mt-5">
  <div class="card shadow">
    <div class="card-body">
      <h2 class="card-title mb-4">Editar Perfil</h2>

        <% if (alert) { %>
        <div class="alert alert-warning text-center"><%= alert %></div>
      <% } %>

      <!-- Formulario con subida de imagen -->
      <form action="/profile" method="POST" enctype="multipart/form-data">
        
        <% if (profile.profile_picture) { %>
            <div class="mb-3 text-center">
              <img src="/uploads/<%= profile.profile_picture %>" alt="Foto de perfil" width="120" class="img-thumbnail">
            </div>
          <% } %>

        <div class="mb-3">
          <label class="form-label">Cambiar Foto de Perfil</label>
          <input type="file" class="form-control" name="profile_picture" accept="image/*">
        </div>


        <div class="mb-3">
          <label class="form-label">Fecha de Nacimiento</label>
          <input type="date" class="form-control" name="birthdate" value="<%= profile.birthdate || '' %>" required>
        </div>


        <div class="mb-3">
          <label class="form-label">Nombres</label>
          <input type="text" class="form-control" name="name" value="<%= profile.name || '' %>">
        </div>
        
        <div class="mb-3">
          <label class="form-label">Apellidos</label>
          <input type="text" class="form-control" name="lastName" value="<%= profile.lastName || '' %>">
        </div>


        <div class="mb-3">
          <label class="form-label">Telefono</label>
          <input type="number" class="form-control" name="phone" value="<%= profile.phone || '' %>" required>
        </div>
        

        <div class="mb-3">
          <label class="form-label">Direccion</label>
          <input type="text" class="form-control" name="address" value="<%= profile.address || '' %>" required>
        </div>

        
        <div class="mb-3">
          <label class="form-label">Genero</label>
          <select name="gender" class="form-select">
            <option value="">-- Selecciona --</option>
            <option value="masculino" <%= profile.gender === 'masculino' ? 'selected' : '' %>>Masculino</option>
            <option value="femenino" <%= profile.gender === 'femenino' ? 'selected' : '' %>>Femenino</option>
            <option value="otro" <%= profile.gender === 'otro' ? 'selected' : '' %>>Otro</option>
          </select>
        </div>


        <div class="mb-3">
          <label class="form-label">Biografía</label>
          <textarea name="bio" class="form-control" rows="4"><%= profile.bio || '' %></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">Idioma preferido</label>
          <select name="language_preference" class="form-select">
            <option value="es" <%= profile.language_preference === 'es' ? 'selected' : '' %>>Español</option>
            <option value="en" <%= profile.language_preference === 'en' ? 'selected' : '' %>>Inglés</option>
            <option value="fr" <%= profile.language_preference === 'fr' ? 'selected' : '' %>>Francés</option>
          </select>
        </div>

        <div class="form-check mb-3">
          <input type="checkbox" name="notifications_enabled" class="form-check-input" id="notifCheck"
            <%= profile.notifications_enabled ? 'checked' : '' %>>
          <label class="form-check-label" for="notifCheck">Recibir notificaciones</label>
        </div>

        
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a href="/miPerfil" class="btn btn-outline-secondary">← Volver a mi perfil</a>
        <a href="/dashboard" class="btn btn-outline-secondary">← Volver al dashboard</a>

      </form>
    </div>
  </div>
</div>
<script>
    const fileInput = document.querySelector('input[name="profile_picture"]');
    const form = document.querySelector('form');
  
    form.addEventListener('submit', function (e) {
      const file = fileInput.files[0];
  
      if (file) {
        const validTypes = ['image/jpeg', 'image/png', 'image/jpg'];
        const maxSize = 2 * 1024 * 1024; // 2MB
  
        if (!validTypes.includes(file.type)) {
          e.preventDefault();
          alert('⚠️ Solo se permiten imágenes JPG o PNG.');
          return;
        }
  
        if (file.size > maxSize) {
          e.preventDefault();
          alert('⚠️ La imagen no debe superar los 2MB.');
          return;
        }
      }
    });
  </script>
  
</body>
</html>
