<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Lista de Elecciones</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-light">


      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">Panel de Control - Sistema de Votación FIS - USTA</a>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav ms-auto">
                        <li class="icono-inicio">
                <a href="/" title="Inicio">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-house-door" viewBox="0 0 16 16">
                    <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4z"/>
                  </svg>
                  <span>Inicio</span>
                </a>
              </li>
             <li class="icono-nameUser">
              <a href="/miPerfil" class="nav-link text-warning d-flex align-items-center">
                <svg class="icon-user" xmlns="http://www.w3.org/2000/svg"  viewBox="0 0 16 16" width="30" height="30" fill="currentColor">
                  <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                </svg>
                <span class="ms-1">Bienvenido, <strong><%= user.username %></strong></span>
              </a>
            </li>
            <li class="icono-cerrar-sesion">
              <a class="nav-link text-white"
                href="/logout">Cerrar Sesión</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>


<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-body">
      <h2 class="mb-4">Elecciones Registradas</h2>


      <% if (alert) { %>
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
      <% } %>
      

      <a href="/dashboard" class="btn btn-outline-secondary mb-3">← Volver al Dashboard</a>
      <a href="/resultados" class="btn btn-outline-secondary mb-3">Ver Resultados</a>

      <a href="/elecciones/crear" class="btn btn-success mb-3 float-end">➕ Nueva Elección</a>

        <form class="d-flex gap-2 mb-3" action="" method="GET">
        <input type="text" class="form-control" name = "busqueda" placeholder="Buscar por nombre o descripción" value="<%= busqueda || '' %>">
        
        <select class="form-select" name="tipo_representacion">
          <option value="">--- Filtrar por Representación</option>
          <option value="facultad" <%=  tipo_representacion === 'facultad' ? 'selected' : '' %>>Facultad</option>
          <option value="semestre" <%= tipo_representacion === 'semestre' ? 'selected' : '' %> >Semestre</option>
          <option value="comite" <%= tipo_representacion === 'comite' ? 'selected' : '' %> >Comite</option>
        </select>
      
        
        <button class="btn btn-primary" type="submit">Buscar</button>
        <a href="/elecciones" class="btn btn-secondary">Limpiar</a>
      
      </form>

      <table class="table table-hover table-bordered">
        <thead class="table-dark">
          <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Representación</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          <% elecciones.forEach((eleccion, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= eleccion.nombre %></td>
              <td><%= eleccion.descripcion %></td>
              <td>
                <% if (eleccion.tipo_representacion === 'facultad') { %>
                  Facultad
                <% } else if (eleccion.tipo_representacion === 'semestre') { %>
                  Semestre
                <% } else if (eleccion.tipo_representacion === 'comite') { %>
                  Comité
                <% } else { %>
                  <%= eleccion.tipo_representacion %>
                <% } %>
              </td>
              <td><%= new Date(eleccion.fecha_inicio).toLocaleString() %></td>
              <td><%= new Date(eleccion.fecha_fin).toLocaleString() %></td>
              <td>
                <form action="/elecciones/estado/<%= eleccion.id %>" method="POST" class="d-flex gap-2 align-items-center">
                  <select name="nuevo_estado" class="form-select form-select-sm" style="width:auto;">
                    <option value="programada" <%= eleccion.estado === 'programada' ? 'selected' : '' %>>Programada</option>
                    <option value="activa" <%= eleccion.estado === 'activa' ? 'selected' : '' %>>Activa</option>
                    <option value="finalizada" <%= eleccion.estado === 'finalizada' ? 'selected' : '' %>>Finalizada</option>
                  </select>
                  <button type="submit" class="btn btn-sm btn-outline-primary">Cambiar</button>
                </form>
              
                <a href="/elecciones/editar/<%= eleccion.id %>" class="btn btn-sm btn-outline-secondary mt-1">Editar</a>
                <a href="/elecciones/<%= eleccion.id %>/candidatos" class="btn btn-sm btn-outline-success mt-1">Candidatos</a>

              
                <% if (eleccion.estado !== 'activa') { %>
                  <form action="/elecciones/eliminar/<%= eleccion.id %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-outline-danger mt-1" onclick="return confirm('¿Eliminar esta elección?');">Eliminar</button>
                  </form>
                <% } %>
              </td>
              
              
              
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
