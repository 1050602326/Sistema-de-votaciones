<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Elección</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-body">
      <h2 class="mb-4">Editar Elección</h2>

      <% if (alert) { %>
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <form method="POST" action="/elecciones/editar/<%= eleccion.id %>">
        <div class="mb-3">
          <label class="form-label">Nombre</label>
          <input type="text" name="nombre" class="form-control" value="<%= eleccion.nombre %>" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Descripción</label>
          <textarea name="descripcion" class="form-control" rows="3"><%= eleccion.descripcion %></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">Tipo de Representación</label>
          <select name="tipo_representacion" class="form-select" required>
            <option value="facultad" <%= eleccion.tipo_representacion === 'facultad' ? 'selected' : '' %>>Facultad</option>
            <option value="semestre" <%= eleccion.tipo_representacion === 'semestre' ? 'selected' : '' %>>Semestre</option>
            <option value="comite" <%= eleccion.tipo_representacion === 'comite' ? 'selected' : '' %>>Comité</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label">Fecha de Inicio</label>
          <input type="datetime-local" name="fecha_inicio" class="form-control" required
                 value="<%= new Date(eleccion.fecha_inicio).toISOString().slice(0,16) %>">
        </div>

        <div class="mb-3">
          <label class="form-label">Fecha de Fin</label>
          <input type="datetime-local" name="fecha_fin" class="form-control" required
                 value="<%= new Date(eleccion.fecha_fin).toISOString().slice(0,16) %>">
        </div>

        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <a href="/elecciones" class="btn btn-secondary ms-2">Cancelar</a>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
